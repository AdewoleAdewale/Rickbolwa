<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:Rickbolwa.Helper"
             x:Class="Rickbolwa.Views.ChangeTransferPIN"            BackgroundColor="#80000000">

    <Grid VerticalOptions="Center" Padding="20">
        <!-- Main Card -->
        <Frame BackgroundColor="White" CornerRadius="20" Padding="20,24" HasShadow="True">
            <StackLayout Spacing="16">

                <!-- Header Icon -->
                <Frame BackgroundColor="#FDF0DF" CornerRadius="10" HeightRequest="60" WidthRequest="60" 
                       Padding="0" HasShadow="False" HorizontalOptions="Center">
                    <Image Source="Rickbolwawhite" Margin="5"   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <Label Text="Reset Transaction PIN" FontAttributes="Bold" FontSize="18" TextColor="#06581B" HorizontalTextAlignment="Center"/>
                <Label Text="Update your 4-digit PIN for processing payments." FontSize="12" TextColor="#666" HorizontalTextAlignment="Center"/>

                <!-- Input Fields -->
                <StackLayout Spacing="12" Margin="0,10,0,0">
                    <StackLayout Spacing="4">
                        <Label Text="Current PIN" FontSize="12" FontAttributes="Bold" TextColor="#444"/>
                        <Frame BackgroundColor="#F9FAFB" CornerRadius="10" Padding="14,2" HasShadow="False" BorderColor="#E8EBED">
                            <renderers:BorderlessEntry x:Name="OldPINEntry" Placeholder="Enter 4-digit current PIN" 
                                                       FontSize="14" IsPassword="True" MaxLength="4" Keyboard="Numeric" TextColor="#222" ClearButtonVisibility="WhileEditing"/>
                        </Frame>
                    </StackLayout>

                    <StackLayout Spacing="4">
                        <Label Text="New PIN" FontSize="12" FontAttributes="Bold" TextColor="#444"/>
                        <Frame BackgroundColor="#F9FAFB" CornerRadius="10" Padding="14,2" HasShadow="False" BorderColor="#E8EBED">
                            <renderers:BorderlessEntry x:Name="ConfirmPIN" Placeholder="Enter 4-digit new PIN" 
                                                       FontSize="14" IsPassword="True" MaxLength="4" Keyboard="Numeric" TextColor="#222" ClearButtonVisibility="WhileEditing"/>
                        </Frame>
                    </StackLayout>
                </StackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#ECECEC" Margin="0,10"/>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F3F4" TextColor="#333" 
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1" Text="Update PIN" BackgroundColor="#06581B" TextColor="White" 
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Clicked="OnUpdatePinClicked"/>
                </Grid>

            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>