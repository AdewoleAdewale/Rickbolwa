<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:Rickbolwa.Helper"
             x:Class="Rickbolwa.Views.ChangePassword"              BackgroundColor="#80000000">

    <Grid VerticalOptions="Center" Padding="20">
        <!-- Main Card -->
        <Frame BackgroundColor="White" CornerRadius="20" Padding="20,24" HasShadow="True">
            <StackLayout Spacing="16">

                <!-- Header Icon -->
                <Frame BackgroundColor="#E0F5EE" CornerRadius="10" HeightRequest="60" WidthRequest="60" 
                       Padding="0" HasShadow="False" HorizontalOptions="Center">
                    <Image Source="Rickbolwawhite" Margin="5"   HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <Label Text="Change Password" FontAttributes="Bold" FontSize="18" TextColor="#053485" HorizontalTextAlignment="Center"/>
                <Label Text="Secure your account with a new password." FontSize="12" TextColor="#666" HorizontalTextAlignment="Center"/>

                <!-- Warning Notice -->
                <Frame BackgroundColor="#FFF4E5" CornerRadius="8" Padding="12" HasShadow="False">
                    <Label Text="Note: New password must contain a capital letter, a symbol, and be at least 8 characters long." 
                           TextColor="#C47314" FontSize="11" HorizontalTextAlignment="Center"/>
                </Frame>

                <!-- Input Fields -->
                <StackLayout Spacing="12" Margin="0,10,0,0">
                    <StackLayout Spacing="4">
                        <Label Text="Current Password" FontSize="12" FontAttributes="Bold" TextColor="#444"/>
                        <Frame BackgroundColor="#F9FAFB" CornerRadius="10" Padding="14,2" HasShadow="False" BorderColor="#E8EBED">
                            <renderers:BorderlessEntry x:Name="OldPasswordEntry" Placeholder="Enter current password" 
                                                       FontSize="14" IsPassword="True" TextColor="#222" ClearButtonVisibility="WhileEditing"/>
                        </Frame>
                    </StackLayout>

                    <StackLayout Spacing="4">
                        <Label Text="New Password" FontSize="12" FontAttributes="Bold" TextColor="#444"/>
                        <Frame BackgroundColor="#F9FAFB" CornerRadius="10" Padding="14,2" HasShadow="False" BorderColor="#E8EBED">
                            <renderers:BorderlessEntry x:Name="ConfirmPassword" Placeholder="Enter new password" 
                                                       FontSize="14" IsPassword="True" TextColor="#222" ClearButtonVisibility="WhileEditing"/>
                        </Frame>
                    </StackLayout>
                </StackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#ECECEC" Margin="0,10"/>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F3F4" TextColor="#333" 
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1" Text="Update" BackgroundColor="#06581B" TextColor="White" 
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Clicked="OnUpdatePasswordClicked"/>
                </Grid>

            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>