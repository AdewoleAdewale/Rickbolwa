<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:Rickbolwa.Helper"
             x:Class="Rickbolwa.Views.ChangePassword"    Padding="0"
    BackgroundColor="#011C0E"
    NavigationPage.HasNavigationBar="False">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout Spacing="0">

            <!-- ══════════════ HEADER ══════════════ -->
            <yummy:PancakeView Padding="24,52,24,34">
                <yummy:PancakeView.BackgroundGradientStops>
                    <yummy:GradientStopCollection>
                        <yummy:GradientStop Color="#003D22" Offset="0.0"/>
                        <yummy:GradientStop Color="#006B3C" Offset="1.0"/>
                    </yummy:GradientStopCollection>
                </yummy:PancakeView.BackgroundGradientStops>

                <StackLayout Spacing="0">
                    <Label Text="← BACK" TextColor="#A8D5B9" FontSize="11"
                           FontAttributes="Bold" Margin="0,0,0,20">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Grid ColumnDefinitions="Auto,*">
                        <yummy:PancakeView Grid.Column="0" CornerRadius="16"
                            BackgroundColor="White" WidthRequest="56" HeightRequest="56"
                            VerticalOptions="Center">
                            <Image Source="borno" 
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </yummy:PancakeView>
                        <StackLayout Grid.Column="1" Margin="14,0,0,0"
                                     VerticalOptions="Center" Spacing="3">
                            <Label Text="CHANGE PASSWORD"
                                   TextColor="White" FontSize="20" FontAttributes="Bold"
                                   CharacterSpacing="0.8"/>
                            <Label Text="Update your account security credentials"
                                   TextColor="#A8D5B9" FontSize="11"/>
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </yummy:PancakeView>

            <!-- ══════════════ MAIN CARD ══════════════ -->
            <yummy:PancakeView
                CornerRadius="30,30,0,0"
                BackgroundColor="#F2F6F3"
                Padding="20,28,20,60"
                Margin="0,-14,0,0"
                VerticalOptions="FillAndExpand">

                <StackLayout Spacing="22">

                    <!-- Password requirements -->
                    <yummy:PancakeView CornerRadius="16"
                        BackgroundColor="#FFF3E0" Padding="16,14"  BorderColor="#003D22" BorderThickness="1.5">

                        <StackLayout Spacing="6">
                            <Label Text="PASSWORD REQUIREMENTS" TextColor="#7A5C00"
                                   FontSize="9" FontAttributes="Bold" CharacterSpacing="2"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="•" TextColor="#C9A84C"
                                       FontSize="14" Margin="0,0,8,0"/>
                                <Label Grid.Column="1"
                                       Text="Minimum 8 characters"
                                       TextColor="#7A5C00" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="•" TextColor="#C9A84C"
                                       FontSize="14" Margin="0,0,8,0"/>
                                <Label Grid.Column="1"
                                       Text="At least one uppercase letter (A–Z)"
                                       TextColor="#7A5C00" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="•" TextColor="#C9A84C"
                                       FontSize="14" Margin="0,0,8,0"/>
                                <Label Grid.Column="1"
                                       Text="At least one special character (!@#$%)"
                                       TextColor="#7A5C00" FontSize="11"/>
                            </Grid>
                        </StackLayout>
                    </yummy:PancakeView>

                    <!-- Form label -->
                    <Label Text="UPDATE CREDENTIALS" TextColor="{StaticResource PrimaryDarkColor}"
                           FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="2.5" Margin="4,4,0,0"/>

                    <!-- Current password -->
                    <yummy:PancakeView CornerRadius="18" BackgroundColor="White"
                                       HasShadow="True" HeightRequest="64" Padding="0"  BorderColor="#D0E8DA" BorderThickness="1.5">

                        <Grid ColumnDefinitions="64,*" VerticalOptions="FillAndExpand">
                            <yummy:PancakeView Grid.Column="0"
                                CornerRadius="18,0,0,18" BackgroundColor="#FFF3E0">
                                <Label Text="🔒" FontSize="22"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </yummy:PancakeView>
                            <StackLayout Grid.Column="1" VerticalOptions="Center"
                                         Margin="14,0,12,0" Spacing="1">
                                <Label Text="CURRENT PASSWORD" TextColor="#003D22"
                                       FontSize="9" FontAttributes="Bold" CharacterSpacing="2"/>
                                <renderers:BorderlessEntry x:Name="OldPasswordEntry"
                                    Placeholder="Enter existing password"
                                    PlaceholderColor="#AABEAF"
                                    FontSize="14" FontAttributes="Bold"
                                    TextColor="#1A2E25" IsPassword="True"
                                    ClearButtonVisibility="WhileEditing"/>
                            </StackLayout>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- New password -->
                    <yummy:PancakeView CornerRadius="18" BackgroundColor="White"
                                       HasShadow="True" HeightRequest="64" Padding="0" BorderColor="#D0E8DA" BorderThickness="1.5">

                        <Grid ColumnDefinitions="64,*" VerticalOptions="FillAndExpand">
                            <yummy:PancakeView Grid.Column="0"
                                CornerRadius="18,0,0,18" BackgroundColor="#E8F5EE">
                                <Label Text="🔓" FontSize="22"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </yummy:PancakeView>
                            <StackLayout Grid.Column="1" VerticalOptions="Center"
                                         Margin="14,0,12,0" Spacing="1">
                                <Label Text="NEW PASSWORD" TextColor="#003D22"
                                       FontSize="9" FontAttributes="Bold" CharacterSpacing="2"/>
                                <renderers:BorderlessEntry x:Name="ConfirmPassword"
                                    Placeholder="Enter new password"
                                    PlaceholderColor="#AABEAF"
                                    FontSize="14" FontAttributes="Bold"
                                    TextColor="#1A2E25" IsPassword="True"
                                    ClearButtonVisibility="WhileEditing"/>
                            </StackLayout>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- Security note -->
                    <yummy:PancakeView CornerRadius="12" BackgroundColor="#E8F5EE" Padding="12,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="🔒" FontSize="13"
                                   VerticalOptions="Center" Margin="0,0,8,0"/>
                            <Label Grid.Column="1"
                                   Text="After a successful change, you will be logged out and asked to log in again."
                                   TextColor="#4A7A5E" FontSize="10"
                                   LineBreakMode="WordWrap"/>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- Update button -->
                    <yummy:PancakeView CornerRadius="20" HeightRequest="64" HasShadow="True">
                        <yummy:PancakeView.BackgroundGradientStops>
                            <yummy:GradientStopCollection>
                                <yummy:GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="0.0"/>
                                <yummy:GradientStop Color="#007A3D" Offset="1.0"/>
                            </yummy:GradientStopCollection>
                        </yummy:PancakeView.BackgroundGradientStops>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand" Padding="22,0">
                            <Label Grid.Column="0" Text="🔐" FontSize="22" TextColor="White"
                                   VerticalOptions="Center"/>
                            <StackLayout Grid.Column="1" HorizontalOptions="Center"
                                         VerticalOptions="Center" Spacing="2">
                                <Label Text="UPDATE PASSWORD"
                                       TextColor="White" FontSize="15" FontAttributes="Bold"
                                       CharacterSpacing="1.5" HorizontalOptions="Center"/>
                                <Label Text="Secure your BIRS account"
                                       TextColor="#A8D5B9" FontSize="9"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                            <yummy:PancakeView Grid.Column="2" CornerRadius="14"
                                BackgroundColor="White" WidthRequest="40" HeightRequest="40"
                                VerticalOptions="Center">
                                <Label Text="→" TextColor="#011C0E" FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </yummy:PancakeView>
                        </Grid>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <!-- Footer -->
                    <StackLayout HorizontalOptions="Center" Spacing="4" Margin="0,6,0,0">
                        <BoxView Color="#D0E8DA" HeightRequest="1" Margin="40,0"/>
                        <Label Text="BORNO STATE INTERNAL REVENUE SERVICE"
                               TextColor="#C9A84C" FontSize="9" FontAttributes="Bold"
                               CharacterSpacing="2" HorizontalOptions="Center"/>
                    </StackLayout>

                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ScrollView>
</ContentPage>
