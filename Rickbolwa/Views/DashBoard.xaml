<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:dxui="http://dips.xamarin.ui.com"
             x:Class="Rickbolwa.Views.DashBoard"                Padding="0"
             BackgroundColor="#F2F6F3"
             NavigationPage.HasNavigationBar="False">

    <dxui:ModalityLayout Opacity="10" OverlayColor="Transparent">

        <ScrollView>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" BackgroundColor="#F2F6F3">

                <!-- ═══════════════ HEADER ═══════════════ -->
                <yummy:PancakeView Grid.Row="0"
                                   BackgroundGradientStartColor="#06581B"
                                   BackgroundGradientEndColor="#23891A"
                                   BackgroundGradientAngle="135"
                                   CornerRadius="0,0,30,30"
                                   Padding="20,50,20,30">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- Hamburger -->
                        <yummy:PancakeView Grid.Column="0"
                                           BackgroundColor="Transparent"
                                           CornerRadius="12"
                                           WidthRequest="44" HeightRequest="44">
                            <Image Source="hamburgerMenu.png"
                                   WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </yummy:PancakeView>

                        <!-- Title block -->
                        <StackLayout Grid.Column="1" Spacing="2"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                            <Label Text="RICKBOLWA LIMITED"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#AAFFCC"
                                   HorizontalTextAlignment="Center"
                                   CharacterSpacing="3"/>
                            <Label x:Name="WelcomeMessage"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="realdates"
                                   FontSize="11"
                                   TextColor="#CCFFDD"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>

                        <!-- Notification bell -->
                        <yummy:PancakeView Grid.Column="2"
                                           BackgroundColor="Transparent"
                                           CornerRadius="12"
                                           WidthRequest="44" HeightRequest="44">
                            <Image Source="shutdown"  HeightRequest="20"
                                   HorizontalOptions="Center"
                                   
                                   VerticalOptions="Center"/>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_4"></TapGestureRecognizer>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                    </Grid>
                </yummy:PancakeView>

                <!-- ═══════════════ AGENT + COLLECTION CARDS ═══════════════ -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      Margin="16,10,16,0"
                      ColumnSpacing="12">

                    <!-- Super Agent Card -->
                    <yummy:PancakeView Grid.Column="0"
                                    BackgroundGradientStartColor="#06581B"
BackgroundGradientEndColor="#23891A"
                                       BackgroundGradientAngle="135"
                                       CornerRadius="10"
                                       Padding="16,14"
                                       Elevation="8" HasShadow="True"
                                       BorderColor="White" BorderThickness="1">
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="SUPER AGENT"
                                       FontSize="9" FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                       TextColor="#E3A008"/>
                                <yummy:PancakeView Grid.Column="1"
                                                   BackgroundColor="Transparent"
                                                   CornerRadius="6"
                                                   Padding="4,2">
                                    <Label Text="LIVE" FontSize="8"
                                           TextColor="#E3A008"
                                           FontAttributes="Bold"/>
                                </yummy:PancakeView>
                            </Grid>
                            <Label x:Name="realdate"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"/>
                            <BoxView HeightRequest="1" BackgroundColor="White"/>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <Label Text="●" FontSize="8" TextColor="Red" VerticalOptions="Center"/>
                                <Label Text="Active Session"
                                       FontSize="9" TextColor="#CCFFDD"/>
                            </StackLayout>
                        </StackLayout>
                    </yummy:PancakeView>

                    <!-- Collection Point Card -->
                    <yummy:PancakeView Grid.Column="1" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                       BackgroundGradientAngle="135"
                                       CornerRadius="10"
                                       Padding="16,14"
                                       Elevation="8" HasShadow="True"
                                       BorderColor="White" BorderThickness="1">
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="COLLECTION PT"
                                       FontSize="9" FontAttributes="Bold"
                                       CharacterSpacing="1.5"
                                         TextColor="#E3A008"/>
                                <Label Grid.Column="1" Text="📍" FontSize="12"/>
                            </Grid>
                            <Label x:Name="Agents"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"/>
                            <BoxView HeightRequest="1" BackgroundColor="White"/>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <Label Text="●" FontSize="8" TextColor="Red" VerticalOptions="Center"/>
                                <Label Text="Assigned Point"
                                       FontSize="9"   TextColor="#1792de"/>
                            </StackLayout>
                        </StackLayout>
                    </yummy:PancakeView>

                </Grid>

                <!-- ═══════════════ QUICK ACTIONS ═══════════════ -->
                <StackLayout Grid.Row="2" Margin="16,20,16,0" Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="QUICK ACTIONS"
                               FontSize="12" FontAttributes="Bold"
                               CharacterSpacing="2"
                               TextColor="#06581B"/>
                        <Label Grid.Column="1"
                               Text="Swipe for more →"
                               FontSize="10" TextColor="#06581B"/>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <StackLayout Orientation="Horizontal" Spacing="12" Padding="2,4,16,8">

                            <!-- REG VEHICLE -->
                            <yummy:PancakeView WidthRequest="130" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                               BackgroundGradientAngle="160"
                                               CornerRadius="10"
                                               Padding="14,16"
                                               Elevation="10" HasShadow="True"
                                               BorderColor="#E3A008" BorderThickness="1">
                                <StackLayout Spacing="10">
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="5"
                                                       WidthRequest="40" HeightRequest="40"
                                                       HorizontalOptions="Start">
                                        <Image Source="gooddone"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </yummy:PancakeView>
                                    <Label Text="Register&#x0a;Vehicle"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="White"
                                           LineBreakMode="NoWrap"/>
                                    <Label Text="Enroll new vehicle into system"
                                           FontSize="9" TextColor="White"
                                           LineBreakMode="WordWrap"/>
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="8"
                                                       Padding="8,6"
                                                       BorderColor="#E3A008" BorderThickness="1">
                                        <Label Text="GET STARTED →"
                                               FontSize="9" FontAttributes="Bold"
                                               TextColor="#E3A008"
                                               HorizontalTextAlignment="Center"/>
                                        <yummy:PancakeView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                                        </yummy:PancakeView.GestureRecognizers>
                                    </yummy:PancakeView>
                                </StackLayout>
                            </yummy:PancakeView>

                            <!-- VERIFY VEHICLE -->
                            <yummy:PancakeView WidthRequest="130" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                               BackgroundGradientAngle="160"
                                               CornerRadius="10"
                                               Padding="14,16"
                                               Elevation="10" HasShadow="True"
                                               BorderColor="#E3A008" BorderThickness="1">
                                <StackLayout Spacing="10">
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="5"
                                                       WidthRequest="40" HeightRequest="40"
                                                       HorizontalOptions="Start">
                                        <Image Source="gooddone"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
                                    </yummy:PancakeView>
                                    <Label Text="Verify Plate No."
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="White"/>
                                    <Label Text="Search vehicle by plate number"
                                           FontSize="9" TextColor="White"
                                           LineBreakMode="WordWrap"/>
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="8"
                                                       Padding="8,6"
                                                       BorderColor="#E3A008" BorderThickness="1">
                                        <Label Text="VERIFY NOW →"
                                               FontSize="9" FontAttributes="Bold"
                                               TextColor="#06581B"
                                               HorizontalTextAlignment="Center"/>
                                        <yummy:PancakeView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                        </yummy:PancakeView.GestureRecognizers>
                                    </yummy:PancakeView>
                                </StackLayout>
                            </yummy:PancakeView>

                            <!-- HISTORY -->
                            <yummy:PancakeView WidthRequest="130"
                                              BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                               BackgroundGradientAngle="160"
                                               CornerRadius="10"
                                               Padding="14,16"
                                               Elevation="10" HasShadow="True"
                                               BorderColor="#E3A008" BorderThickness="1">
                                <StackLayout Spacing="10">
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="5"
                                                       WidthRequest="40" HeightRequest="40"
                                                       HorizontalOptions="Start">
                                        <Image Source="gooddone"
HorizontalOptions="Center"
VerticalOptions="Center"/>
                                    </yummy:PancakeView>
                                    <Label Text="Agent History"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="White"/>
                                    <Label Text="View all transaction records"
                                           FontSize="9" TextColor="White"
                                           LineBreakMode="WordWrap"/>
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="8"
                                                       Padding="8,6"
                                                       BorderColor="#E3A008" BorderThickness="1">
                                        <Label Text="VIEW ALL →"
                                               FontSize="9" FontAttributes="Bold"
                                               TextColor="#06581B"
                                               HorizontalTextAlignment="Center"/>
                                        <yummy:PancakeView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                                        </yummy:PancakeView.GestureRecognizers>
                                    </yummy:PancakeView>
                                </StackLayout>
                            </yummy:PancakeView>

                            <!-- OTHERS / SETTINGS -->
                            <yummy:PancakeView WidthRequest="130" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                               BackgroundGradientAngle="160"
                                               CornerRadius="10"
                                               Padding="14,16"
                                               Elevation="10" HasShadow="True"
                                               BorderColor="#E3A008" BorderThickness="1">
                                <StackLayout Spacing="10">
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="5"
                                                       WidthRequest="40" HeightRequest="40"
                                                       HorizontalOptions="Start">
                                        <Label Text="⚙️" FontSize="20" TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </yummy:PancakeView>
                                    <Label Text="Account Settings"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="White"/>
                                    <Label Text="Reset password and PIN"
                                           FontSize="9" TextColor="White"
                                           LineBreakMode="WordWrap"/>
                                    <yummy:PancakeView BackgroundColor="White"
                                                       CornerRadius="8"
                                                       Padding="8,6"
                                                       BorderColor="#E3A008" BorderThickness="1">
                                        <Label Text="MANAGE →"
                                               FontSize="9" FontAttributes="Bold"
                                               TextColor="#06581B"
                                               HorizontalTextAlignment="Center"/>
                                        <yummy:PancakeView.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_8"/>
                                        </yummy:PancakeView.GestureRecognizers>
                                    </yummy:PancakeView>
                                </StackLayout>
                            </yummy:PancakeView>

                        </StackLayout>
                    </ScrollView>
                </StackLayout>

                <!-- ═══════════════ TODAY'S SUMMARY STRIP ═══════════════ -->
                <yummy:PancakeView Grid.Row="3"
                                   Margin="16,10,16,0" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                   BackgroundGradientAngle="90"
                                   CornerRadius="10"
                                   Padding="16,14"
                                   BorderColor="#00FF8840" BorderThickness="1">
                    <Grid ColumnDefinitions="*,1,*,1,*">
                        <StackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Label Text="+ " FontSize="20" HorizontalOptions="Center" TextColor="White" />
                            <Label x:Name="TodayTxnCount"
                                   Text="—" FontSize="18" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="Today's Txns"
                                   FontSize="9" TextColor="#99BBAA"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                        <BoxView Grid.Column="1" BackgroundColor="White"
                                 WidthRequest="1" VerticalOptions="Fill"/>
                        <StackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Label Text="+ " FontSize="20" HorizontalOptions="Center" TextColor="White"/>
                            <Label x:Name="TodayAmount"
                                   Text="—" FontSize="18" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="Total (₦)"
                                   FontSize="9" TextColor="#99AABB"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                        <BoxView Grid.Column="3" BackgroundColor="White"
                                 WidthRequest="1" VerticalOptions="Fill"/>
                        <StackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                            <Label Text="+ " FontSize="20" HorizontalOptions="Center" TextColor="White"/>
                            <Label x:Name="TodayVehicles"
                                   Text="—" FontSize="18" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="Vehicles"
                                   FontSize="9" TextColor="#AABBCC"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Grid>
                </yummy:PancakeView>

                <!-- ═══════════════ RECENT TRANSACTIONS ═══════════════ -->
                <StackLayout Grid.Row="4" Margin="16,20,16,0" Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="RECENT TRANSACTIONS"
                               FontSize="12" FontAttributes="Bold"
                               CharacterSpacing="2"
                               TextColor="#06581B"/>
                        <Label Grid.Column="1"
                               Text="See all"
                               FontSize="11" TextColor="#06581B"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <ListView x:Name="listView"
                              BackgroundColor="Transparent"
                              ItemsSource="{Binding HD}"
                              HeightRequest="300"
                              HorizontalOptions="FillAndExpand"
                              HasUnevenRows="True"
                              SeparatorVisibility="None"
                              VerticalOptions="FillAndExpand">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <yummy:PancakeView Margin="0,0,0,10" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                                       BackgroundGradientAngle="135"
                                                       CornerRadius="16"
                                                       Padding="14,12"
                                                       BorderColor="White" BorderThickness="1"
                                                       Elevation="5" HasShadow="True">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

                                            <!-- Icon circle -->
                                            <yummy:PancakeView Grid.Column="0"
                                                               BackgroundColor="White"
                                                               CornerRadius="14"
                                                               WidthRequest="44" HeightRequest="44"
                                                               VerticalOptions="Center">
                                                <Image Source="Rickbolwawhite" 
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </yummy:PancakeView>

                                            <!-- Details -->
                                            <StackLayout Grid.Column="1" Spacing="3"
                                                         Margin="12,0,0,0"
                                                         VerticalOptions="Center">
                                                <Label Text="{Binding businessName}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="White"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding serviceName}"
                                                       FontSize="11" TextColor="White"/>
                                                <Label Text="{Binding dateRecorded, StringFormat='{}{0:MMM d, yyyy  h:mm tt}'}"
                                                       FontSize="9" TextColor="White"/>
                                            </StackLayout>

                                            <!-- Amount badge -->
                                            <StackLayout Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End"
                                                         Spacing="4">
                                                <yummy:PancakeView BackgroundColor="#00FF8818"
                                                                   CornerRadius="8"
                                                                   Padding="8,4"
                                                                   BorderColor="#00FF8850" BorderThickness="1">
                                                    <Label Text="{Binding amount}"
                                                           FontSize="12" FontAttributes="Bold"
                                                           TextColor="#00FF88"
                                                           HorizontalTextAlignment="Center"/>
                                                </yummy:PancakeView>
                                                <Label Text="₦" FontSize="9"
                                                       TextColor="#667788"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>

                                        </Grid>
                                    </yummy:PancakeView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </StackLayout>

                <!-- ═══════════════ FOOTER ═══════════════ -->
                <StackLayout Grid.Row="5"
                             Margin="0,10,0,0"
                             Padding="20,16"
                             BackgroundColor="White">
                    <BoxView HeightRequest="1" BackgroundColor="#06581B" Margin="0,0,0,14"/>
                    <Label Text="POWERED BY OSOFTPAY"
                           TextColor="#06581B"
                           HorizontalOptions="CenterAndExpand"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="2"/>
                    <Label Text="© 2026 Rickbolwa Limited"
                           TextColor="#06581B" FontSize="9"
                           HorizontalOptions="CenterAndExpand"
                           Margin="0,4,0,0"/>
                </StackLayout>

            </Grid>
        </ScrollView>

        <!-- ═══════════════ FLOATING ACTION MENU ═══════════════ -->
        <dxui:ModalityLayout.Behaviors>
            <dxui:FloatingActionMenuBehaviour Size="56"
                                              ExpandButtonBackgroundColor="#06581B"
                                              ExpandButtonText="MORE"
                                              ExpandButtonFontSize="12"
                                              Source="icons.png"
                                              
                                              ExpandButtonTextColor="White"
                                              XPosition=".88"
                                              YPosition=".92"
                                              IsVisible="true">
                <dxui:MenuButton BackgroundColor="#06581B"
                                 Text="TEST PRINTER"
                                 x:Name="FirstButton"
                                 Padding="5"
                                 TextColor="White"
                                 Margin="5"
                                 HeightRequest="46"
                                 Title="TEST PRINTER"
                                 Source="PRINT.png">
                    <dxui:MenuButton.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_2"/>
                    </dxui:MenuButton.GestureRecognizers>
                </dxui:MenuButton>
                <dxui:MenuButton BackgroundColor="#B22222"
                                 Text="LOGOUT"
                                 TextColor="White"
                                 Padding="5"
                                 Margin="5"
                                 Title="LOGOUT"
                                 HeightRequest="46"
                                 Source="shutdown.png">
                    <dxui:MenuButton.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_7"/>
                    </dxui:MenuButton.GestureRecognizers>
                </dxui:MenuButton>
            </dxui:FloatingActionMenuBehaviour>
        </dxui:ModalityLayout.Behaviors>

    </dxui:ModalityLayout>
</ContentPage>
