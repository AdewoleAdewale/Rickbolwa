<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="Rickbolwa.Views.DashBoard"    BackgroundColor="{StaticResource PageBackgroundLight}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════════ HERO ══════════════ -->
        <yummy:PancakeView Grid.Row="0"
                           Padding="24,52,24,28"
                           CornerRadius="0,0,32,32"
                           BackgroundGradientStops="{StaticResource HeroGradient}"
                           BackgroundGradientAngle="135">
            <StackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                    <yummy:PancakeView Grid.Column="0" CornerRadius="12"
                                       BackgroundColor="#22FFFFFF"
                                       WidthRequest="42" HeightRequest="42">
                        <Label Text="←" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_4"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <StackLayout Grid.Column="1" HorizontalOptions="Center"
                                 VerticalOptions="Center" Spacing="0">
                        <Label Text="HAULAGE" Style="{StaticResource BrandMarkLabel}"
                               FontSize="14" HorizontalOptions="Center"/>
                        <Label x:Name="BrandName" Style="{StaticResource HeroSubLabel}"
                               FontSize="9" CharacterSpacing="1" HorizontalOptions="Center"/>
                    </StackLayout>

                    <yummy:PancakeView Grid.Column="2" CornerRadius="21"
                                       BackgroundColor="{StaticResource AccentColor}"
                                       WidthRequest="42" HeightRequest="42">
                        <Label x:Name="AvatarInitial" FontSize="17" FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDeepColor}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_8"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>
                </Grid>

                <Label x:Name="WelcomeMessage" Style="{StaticResource HeroTitleLabel}"/>
                <Label Text="Haulage revenue collection" Style="{StaticResource HeroSubLabel}"/>
            </StackLayout>
        </yummy:PancakeView>

        <!-- ══════════════ ACTIONS ══════════════ -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,22,20,28" Spacing="16">

                <Label Text="QUICK ACTIONS" Style="{StaticResource SectionLabel}"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="14" RowSpacing="14">

                    <yummy:PancakeView Grid.Row="0" Grid.Column="0" Style="{StaticResource TileView}">
                        <StackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="💰" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="VERIFY &amp; PAY" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <yummy:PancakeView Grid.Row="0" Grid.Column="1" Style="{StaticResource TileView}">
                        <StackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🚚" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="VEHICLE REGISTRATION" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <yummy:PancakeView Grid.Row="1" Grid.Column="0" Style="{StaticResource TileView}">
                        <StackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="🕘" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="HISTORY" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                    <yummy:PancakeView Grid.Row="1" Grid.Column="1" Style="{StaticResource TileView}"
                                       BackgroundColor="{StaticResource PrimaryDarkColor}">
                        <StackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="⚙️" FontSize="30" HorizontalOptions="Center"/>
                            <Label Text="ACCOUNT &amp; TOOLS" FontSize="11" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                        </StackLayout>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_8"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>
                </Grid>

                <Label x:Name="FooterBrand" Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center" Margin="0,10,0,0"/>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
