<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:extensions="http://xamarin.com/schemas/2020/toolkit" xmlns:renderers="clr-namespace:Rickbolwa.Helper"
             x:Class="Rickbolwa.Views.Verify"           Padding="0"
             BackgroundColor="#F2F6F3"
             NavigationPage.HasNavigationBar="True">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout Spacing="0">

            <!-- ══════════ GRADIENT HEADER ══════════ -->
            <yummy:PancakeView BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                               BackgroundGradientAngle="135"
                               CornerRadius="0,0,20,20"
                               Padding="24,50,24,30">
                <StackLayout Spacing="6">
                    <Label Text="VEHICLE VERIFICATION"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Enter a plate number to retrieve vehicle details"
                           FontSize="11" TextColor="White"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </yummy:PancakeView>

            <!-- ══════════ SEARCH CARD ══════════ -->
            <yummy:PancakeView Margin="16,-16,16,0"
                               Padding="20,20"
                               BackgroundColor="White"
                               CornerRadius="10"
                               Elevation="10" HasShadow="True"
                               BorderColor="White" BorderThickness="1">
                <StackLayout Spacing="14">

                    <Label Text="PLATE NUMBER"
                           FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#23891A"/>

                    <!-- Search input with icon -->
                    <yummy:PancakeView BackgroundColor="White"
                                       CornerRadius="14"
                                       HeightRequest="54"
                                       BorderColor="LightGray" BorderThickness="1"
                                       Padding="0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="+ " TextColor="#23891A"
                                   FontSize="18" VerticalOptions="Center"
                                   Margin="16,0,0,0"/>
                            <renderers:BorderlessEntry
                                Grid.Column="1"
                                x:Name="Search"
                                FontSize="15" FontAttributes="Bold"
                                Placeholder="e.g. ABC-123-XY"
                                PlaceholderColor="#334455"
                                TextColor="#23891A"
                                Keyboard="Text"
                                ClearButtonVisibility="WhileEditing"
                                Margin="10,0,0,0"
                                BackgroundColor="Transparent"/>
                            <yummy:PancakeView Grid.Column="2" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                                              BackgroundColor="#23891A"
                                              CornerRadius="10"
                                              Margin="8"
                                              Padding="14,8">
                                <Label Text="CLEAR" FontSize="9" HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       TextColor="White">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ClearSearch_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </yummy:PancakeView>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- Search button -->
                    <yummy:PancakeView BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                       BackgroundGradientAngle="90"
                                       CornerRadius="14"
                                       HeightRequest="54"
                                       Elevation="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="+ " TextColor="White"
                                   FontSize="20" VerticalOptions="Center"
                                   Margin="18,0,0,0"/>
                            <Label Grid.Column="1"
                                   Text="GET PLATE INFORMATION"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="→"
                                   FontSize="18" TextColor="#AAFFCC"
                                   VerticalOptions="Center"
                                   Margin="0,0,18,0"/>
                        </Grid>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                        </yummy:PancakeView.GestureRecognizers>
                    </yummy:PancakeView>

                </StackLayout>
            </yummy:PancakeView>

            <!-- ══════════ RESULT CARD (shown after search) ══════════ -->
            <StackLayout x:Name="ResultPanel"
                         IsVisible="False"
                         Margin="16,20,16,30"
                         Spacing="14">

                <!-- Result header -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                    <Label Grid.Column="0"
                           Text="VEHICLE DETAILS"
                           FontSize="12" FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#06581B"/>
                    <yummy:PancakeView Grid.Column="1"
                                       x:Name="StatusBadge"
                                       BackgroundColor="#00FF8820"
                                       CornerRadius="8"
                                       Padding="10,4"
                                       BorderColor="#00FF8860" BorderThickness="1">
                        <Label x:Name="StatusBadgeText"
                               Text="ACTIVE"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="Red"/>
                    </yummy:PancakeView>
                </Grid>

                <!-- Main detail card -->
                <yummy:PancakeView BackgroundColor="White"
                                   CornerRadius="10"
                                   Padding="20"
                                   Elevation="10" HasShadow="True"
                                   BorderColor="White" BorderThickness="1">
                    <StackLayout Spacing="0">

                        <!-- Plate number hero -->
                        <yummy:PancakeView   BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                           BackgroundGradientAngle="135"
                                           CornerRadius="14"
                                           Padding="16,14"
                                           Margin="0,0,0,16">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Image Source="gooddone" Grid.Column="0"
                                       HeightRequest="28" VerticalOptions="Center"/>
                                <StackLayout Grid.Column="1" Spacing="2" Margin="12,0,0,0">
                                    <Label Text="PLATE NUMBER"
                                           FontSize="9" CharacterSpacing="1.5"
                                           TextColor="#AAFFCC"/>
                                    <Label x:Name="plateNumbers"
                                           FontSize="22" FontAttributes="Bold"
                                           TextColor="White"/>
                                </StackLayout>
                                <yummy:PancakeView Grid.Column="2"
                                                   BackgroundColor="White"
                                                   CornerRadius="5"
                                                   Padding="10,6">
                                    <Label Text="NGR" FontSize="10" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           FontAttributes="Bold"
                                           TextColor="#06581B"/>
                                </yummy:PancakeView>
                            </Grid>
                        </yummy:PancakeView>

                        <!-- Detail rows -->
                        <!-- Driver Name -->
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
                            <StackLayout Grid.Column="0" Spacing="3">
                                <Label Text="DRIVER NAME"
                                       FontSize="9" CharacterSpacing="1"
                                       TextColor="#667788"/>
                                <Label x:Name="nameofDrivers"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="Black"/>
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="3">
                                <Label Text="PHONE NUMBER"
                                       FontSize="9" CharacterSpacing="1"
                                       TextColor="#667788"/>
                                <Label x:Name="ownerPhones"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="Black"/>
                            </StackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#06581B" Margin="0,0,0,12"/>

                        <!-- Vehicle + LGA -->
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
                            <StackLayout Grid.Column="0" Spacing="3">
                                <Label Text="VEHICLE TYPE"
                                       FontSize="9" CharacterSpacing="1"
                                       TextColor="#667788"/>
                                <Label x:Name="vehicleTypes"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="#06581B"/>
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="3">
                                <Label Text="LGA"
                                       FontSize="9" CharacterSpacing="1"
                                       TextColor="#667788"/>
                                <Label x:Name="lga"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="Black"/>
                            </StackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#06581B" Margin="0,0,0,12"/>

                        <!-- Amount + Date -->
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
                            <StackLayout Grid.Column="0" Spacing="3">
                                <Label Text="LEVY AMOUNT"
                                       FontSize="9" CharacterSpacing="1"
                                       TextColor="#667788"/>
                                <StackLayout Orientation="Horizontal" Spacing="2">
                                    <Label Text="₦" FontSize="12" TextColor="#06581B"
                                           VerticalOptions="End" Margin="0,0,0,2"/>
                                    <Label x:Name="Amount"
                                           FontSize="20" FontAttributes="Bold"
                                           TextColor="#06581B"/>
                                </StackLayout>
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="3">
                                <Label Text="DATE RECORDED"
                                       FontSize="9" CharacterSpacing="1"
                                       TextColor="#FFAA44"/>
                                <Label x:Name="DateRecorded"
                                       FontSize="12"
                                       TextColor="Black"/>
                            </StackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#06581B" Margin="0,0,0,12"/>

                        <!-- Status message -->
                        <yummy:PancakeView BackgroundColor="White"
                                           CornerRadius="10"
                                           Padding="12,8"
                                           BorderColor="White" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="●" FontSize="12"
                                       TextColor="Red"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                                <Label Grid.Column="1"
                                       x:Name="messages"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="#06581B"/>
                            </Grid>
                        </yummy:PancakeView>

                    </StackLayout>
                </yummy:PancakeView>

                <!-- MAKE PAYMENT button -->
                <yummy:PancakeView x:Name="makePaymentPanel"
                                   IsVisible="False" BackgroundGradientStartColor="#06581B"
 BackgroundGradientEndColor="#23891A"
                                   BackgroundGradientAngle="90"
                                   CornerRadius="16"
                                   HeightRequest="58"
                                   Elevation="8"
                                   BorderColor="#00FF8840" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="+" FontSize="22" TextColor="White"
                               VerticalOptions="Center" Margin="18,0,0,0"/>
                        <Label Grid.Column="1"
                               Text="MAKE PAYMENT"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="→" FontSize="18"
                               TextColor="#AAFFCC"
                               VerticalOptions="Center" Margin="0,0,18,0"/>
                    </Grid>
                    <yummy:PancakeView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="make_Clicked"/>
                    </yummy:PancakeView.GestureRecognizers>
                </yummy:PancakeView>

                <!-- Hidden legacy button kept for code-behind reference -->
                <Button x:Name="make" IsVisible="False"
                        Text="MAKE PAYMENT"
                        Clicked="make_Clicked"
                        BackgroundColor="#06581B"
                        TextColor="White"/>

            </StackLayout>

            <!-- Empty state (shown when no result yet) -->
            <StackLayout x:Name="EmptyState"
                         Margin="16,40,16,40"
                         Spacing="16"
                         HorizontalOptions="Center">
                <Label Text="🚦" FontSize="60" HorizontalOptions="Center"/>
                <Label Text="No vehicle searched yet"
                       FontSize="14" TextColor="#334455"
                       HorizontalOptions="Center"/>
                <Label Text="Enter a plate number above and tap&#x0a;'GET PLATE INFORMATION'"
                       FontSize="11" TextColor="#2A3A4A"
                       HorizontalTextAlignment="Center"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>