<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rickbolwa.Views.WaterFailureSheet"             BackgroundColor="#80000000">

    <Grid VerticalOptions="End">
        <Frame BackgroundColor="White" CornerRadius="24" Padding="20,24" HasShadow="True" Margin="0,0,0,-10">
            <StackLayout Spacing="14">

                <!-- Failure Icon -->
                <Frame BackgroundColor="#FDE8E8" CornerRadius="30" HeightRequest="60" WidthRequest="60" 
                       Padding="0" HasShadow="False" HorizontalOptions="Center">
                    <Label Text="✕" TextColor="#C41C1C" FontSize="26" FontAttributes="Bold" 
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <Label x:Name="TitleLabel" Text="Action Failed" FontAttributes="Bold" FontSize="18" 
                       TextColor="#C41C1C" HorizontalTextAlignment="Center"/>
                <Label x:Name="ReasonLabel" Text="An error occurred while processing your request." 
                       TextColor="#555" FontSize="12" HorizontalTextAlignment="Center"/>

                <Button Text="Try Again / Dismiss" BackgroundColor="#C41C1C" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="10" HeightRequest="46" Margin="0,10,0,10"
                        Clicked="OnDismissClicked"/>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>