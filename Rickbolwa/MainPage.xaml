<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:Rickbolwa.Helper"
             x:Class="Rickbolwa.MainPage" 
             BackgroundColor="{StaticResource SurfaceColor}"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <yummy:GradientStopCollection x:Key="WaveGradient">
                <yummy:GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                <yummy:GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1"/>
            </yummy:GradientStopCollection>

            <yummy:GradientStopCollection x:Key="ButtonGradient">
                <yummy:GradientStop Color="#053485" Offset="0"/>
                <yummy:GradientStop Color="{StaticResource PrimaryColor}" Offset="0.55"/>
                <yummy:GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1"/>
            </yummy:GradientStopCollection>

            <Style x:Key="FieldLine" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1"/>
                <Setter Property="Color" Value="{StaticResource DividerColor}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="8,4,8,6" RowDefinitions="Auto" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">

            <!-- ═══════════════ LOGIN CARD ═══════════════ -->
            <yummy:PancakeView BackgroundColor="{StaticResource SurfaceColor}" 
                               CornerRadius="28"
                               Elevation="14" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                               Padding="0">
                <StackLayout Spacing="0" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand">

                    <!-- ────────── Card body ────────── -->
                    <StackLayout Padding="26,32,26,26" Spacing="0">

                        <!-- Title -->
                        <Label Text="Login Rickbolwa"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="27"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                        <!-- Terms line -->
                        <Label HorizontalTextAlignment="Center"
                               Margin="0,10,0,0"
                               FontSize="13">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="By signing in you are agreeing our&#10;"
                                          TextColor="{StaticResource TextSecondaryColor}"/>
                                    <Span Text="Terms and privacy policy"
                                          TextColor="{StaticResource PrimaryColor}"
                                          FontAttributes="Bold"/>
                                </FormattedString>
                            </Label.FormattedText>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- ────────── Tabs ────────── -->
                        <Grid ColumnDefinitions="*,*"
                              HorizontalOptions="Center"
                              WidthRequest="240"
                              Margin="0,24,0,4">

                            <StackLayout Grid.Column="0" Spacing="7">
                                <Label Text="Login"
                                       TextColor="{StaticResource PrimaryColor}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <BoxView HeightRequest="3"
                                         WidthRequest="42"
                                         CornerRadius="1.5"
                                         Color="{StaticResource AccentColor}"
                                         HorizontalOptions="Center"/>
                            </StackLayout>

                            <StackLayout Grid.Column="1" Spacing="7">
                                <Label Text="Rickbolwa"
                                       TextColor="{StaticResource TextSecondaryColor}"
                                       FontSize="15"
                                       HorizontalOptions="Center"/>
                                <BoxView HeightRequest="3"
                                         WidthRequest="42"
                                         CornerRadius="1.5"
                                         Color="Transparent"
                                         HorizontalOptions="Center"/>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                        </Grid>

                        <!-- ────────── Email field ────────── -->
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14"
                              Margin="0,26,0,0">
                            <Label Grid.Column="0"
                                   Text="✉"
                                   FontSize="19"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"/>
                            <renderers:BorderlessEntry Grid.Column="1"
                                   x:Name="Email"
                                   Placeholder="Email Address"
                                   PlaceholderColor="{StaticResource TextSecondaryColor}"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   FontSize="15"
                                   BackgroundColor="Transparent"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   HeightRequest="44"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Style="{StaticResource FieldLine}" Margin="0,2,0,0"/>

                        <!-- ────────── Password field ────────── -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Margin="0,22,0,0">
                            <Label Grid.Column="0"
                                   Text="🔒"
                                   FontSize="17"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"/>
                            <renderers:BorderlessEntry Grid.Column="1"
                                   x:Name="Password"
                                   Placeholder="Password"
                                   PlaceholderColor="{StaticResource TextSecondaryColor}"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   FontSize="15"
                                   BackgroundColor="Transparent"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   HeightRequest="44"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="2"
                                   x:Name="TogglePasswordIcon"
                                   Text="👁"
                                   FontSize="17"
                                   Padding="8,0"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTogglePassword"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <BoxView Style="{StaticResource FieldLine}" Margin="0,2,0,0"/>

                        <!-- ────────── Remember / Forgot ────────── -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Margin="0,20,0,0">

                            <StackLayout Grid.Column="0"
                                         Orientation="Horizontal"
                                         Spacing="9">
                                <yummy:PancakeView x:Name="RememberBox"
                                                   WidthRequest="20" HeightRequest="20"
                                                   CornerRadius="5"
                                                   BackgroundColor="{StaticResource PrimaryColor}"
                                                   Padding="0"
                                                   VerticalOptions="Center">
                                    <Label x:Name="RememberTick"
                                           Text="✓"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </yummy:PancakeView>
                                <Label Text="Remember me"
                                       TextColor="{StaticResource TextSecondaryColor}"
                                       FontSize="13"
                                       VerticalOptions="Center"/>
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRememberToggled"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>

                            <Label Grid.Column="2"
                                   Text="Forgot password"
                                   TextColor="{StaticResource PrimaryColor}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgotPassword"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- ────────── Sign in button ────────── -->
                        <yummy:PancakeView CornerRadius="12"
                                           Elevation="6"
                                           Padding="0"
                                           Margin="0,26,0,0"
                                           BackgroundGradientStops="{StaticResource ButtonGradient}"
                                           BackgroundGradientAngle="120">
                            <Button x:Name="SignInButton"
                                    Text="Login"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="52"
                                    CornerRadius="12"
                                    Clicked="OnSignInClicked"/>
                        </yummy:PancakeView>

                        <!-- ────────── Session note ────────── -->
                        <StackLayout Orientation="Horizontal"
                                     Spacing="7"
                                     HorizontalOptions="Center"
                                     Margin="0,20,0,0">
                            <Label Text="🔐" FontSize="12" VerticalOptions="Center"/>
                            <Label Text="{Binding SessionNote}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   FontSize="11"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                    </StackLayout>

                    <!-- ═══════════════ CURVED BRAND PANEL ═══════════════ -->
                    <yummy:PancakeView BackgroundGradientStops="{StaticResource WaveGradient}"
                                       BackgroundGradientAngle="135" 
                                       CornerRadius="90,90,8,8"
                                       Padding="24,26,24,132">
                        <StackLayout Spacing="10">

                            <yummy:PancakeView WidthRequest="72" HeightRequest="72"
                                               CornerRadius="20"
                                               BackgroundColor="#1AFFFFFF"
                                               BorderColor="#33FFFFFF"
                                       BorderThickness="1"
                                               HorizontalOptions="Center"
                                               Padding="0">
                                <Image Source="Rickbolwawhite"
                                       HeightRequest="58" WidthRequest="58"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </yummy:PancakeView>

                            <Label Text="{Binding OrganisationAbbr}"
                                   TextColor="{StaticResource AccentColor}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   CharacterSpacing="4"
                                   HorizontalOptions="Center"/>

                            <Label Text="{Binding OrganisationName}"
                                   TextColor="White"
                                   FontSize="9.5"
                                   CharacterSpacing="1.2"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center"/>

                            <BoxView HeightRequest="1"
                                     Color="#2EFFFFFF"
                                     Margin="40,8,40,2"/>

                            <Label x:Name="SupportLabel"
                                   TextColor="White"
                                   FontSize="10.5"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </yummy:PancakeView>
                </StackLayout>
            </yummy:PancakeView>
        </Grid>
    </ScrollView>
</ContentPage>
